# ==============================================================================
# CertifAI Backend - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` for local execution or configure in your deployment platform.
# Never commit real credentials or production secrets to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/certifai

# Database Configuration (PostgreSQL)
DATASOURCE_URL=jdbc:postgresql://localhost:5432/certifai_db
DATASOURCE_USERNAME=certifai_user
DATASOURCE_PASSWORD=certifai_password

# Initial Admin Credentials
ADMIN_EMAIL=admin@certifai.com.br
ADMIN_PASSWORD=Admin@SecurePass123!

# Security & JWT Token (HMAC-SHA256 secret, min 256 bits / 32 bytes base64 or hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# SendGrid Email Service
SENDGRID_API_KEY=SG.dummy_sendgrid_api_key_placeholder
SENDGRID_SENDER_EMAIL=certifai.suporte@gmail.com

# Base Application URL (Used in email confirmation / password recovery links)
APP_BASE_URL=http://localhost:8080/certifai

# Google OAuth2 Authentication
CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
CLIENT_SECRET=GOCSPX-dummy_google_client_secret_placeholder
